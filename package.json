{
  "name": "finnish-nhl-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prebuild/fetch-player-stats.cjs && node scripts/prebuild/fetch-last-teams.cjs",
    "build": "npm run prebuild && vite build",
    "build:quick": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "test:seo": "node scripts/validate-seo.cjs",
    "test:watch": "vitest",
    "test:roster": "vitest run src/lib/tests/finnish-roster-integrity.test.js",
    "test:sync": ".venv/bin/python3 scripts/data_collection/finnish/test_sync_roster.py",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate": "npm run lint && npm run check && npm run test",
    "validate:seo": "npm run build:quick && npm run test:seo",
    "validate:fix": "npm run format && npm run validate",
    "validate:watch": "concurrently \"npm run check:watch\" \"npm run lint -- --watch\" \"npm run test:watch\"",
    "data:fetch": ".venv/bin/python3 scripts/data_collection/finnish/fetch.py",
    "data:fetch:date": ".venv/bin/python3 scripts/data_collection/finnish/fetch.py",
    "data:fetch:season": ".venv/bin/python3 scripts/data_collection/season/fetch_season_games.py",
    "players:update": "node scripts/node_utils/player-cli.js update",
    "players:validate": "node scripts/node_utils/player-cli.js validate",
    "players:stats": "node scripts/node_utils/player-cli.js stats",
    "players:changes": "node scripts/node_utils/player-cli.js changes",
    "players:backup": "node scripts/node_utils/player-cli.js backup",
    "players:restore": "node scripts/node_utils/player-cli.js restore",
    "players:clean": "node scripts/node_utils/player-cli.js clean",
    "data:realtime": ".venv/bin/python3 scripts/data_collection/realtime_poll.py",
    "goalies:collect": "node scripts/prebuild/collect-all-goalie-stats.cjs",
    "test:browser": "node scripts/test-pages.js",
    "test:browser:prod": "TEST_URL=https://suomalaisetnhlssa.fi node scripts/test-pages.js",
    "prospects:demo": ".venv/bin/python3 scripts/data_collection/leagues/demo_collector.py",
    "prospects:scrape": ".venv/bin/python3 scripts/data_collection/official_leagues.py",
    "prospects:mestis": "node scripts/scraper-advanced.cjs Mestis",
    "prospects:na": ".venv/bin/python3 scripts/data_collection/collegenhl.py",
    "prospects:cache:build": ".venv/bin/python3 scripts/data_collection/finnish/build_prospects_cache.py",
    "prospects:headshots:sync": ".venv/bin/python3 scripts/data_collection/headshots/sync_prospect_headshots.py",
    "prospects:leagues": "echo 'Options: npm run prospects:scrape (real data) | npm run prospects:demo (sample data)'",
    "prospects:leagues:update": "npm run prospects:scrape && npm run prospects:na && npm run prospects:mestis && npm run prospects:headshots:sync && npm run prospects:cache:build && npm run goalies:collect",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,svelte}": ["biome check --write --no-errors-on-unmatched"],
    "src/**/*.{json,css}": ["biome format --write"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^25.0.3",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.11",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.37.5",
    "svelte": "^5.29.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.16",
    "terser": "^5.44.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "dependencies": {
    "alpinejs": "^3.15.2",
    "flatpickr": "^4.6.13",
    "marked": "^17.0.1",
    "swiper": "^12.0.3"
  }
}
