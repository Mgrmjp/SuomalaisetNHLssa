# Copy to .env.local and fill only the keys needed for your tasks.
# The static dashboard works without credentials.
# Defaults live in tracked code; see docs/CONFIGURATION.md.

# Required for collecting fresh Finnish NHL news.
TAVILY_API_KEY=

# Optional: Finnish news translations and player-name correction.
OPENAI_API_KEY=

# Optional providers for separately invoked prospect/league collectors.
# APIHOCKEY_KEY=
# ELITEPROSPECTS_API_KEY=
# THE_SPORTS_DB_KEY=
