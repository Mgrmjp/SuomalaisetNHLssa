# Security headers for all deployed responses
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://gc.zgo.at https://cdn.jsdelivr.net https://storage.ko-fi.com; connect-src 'self' https://api-web.nhle.com https://api.nhle.com https://suomalaisetnhlssa.goatcounter.com https://*.goatcounter.com; frame-src https://ko-fi.com https://storage.ko-fi.com; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Immutable content - allow aggressively caching
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets (images, logos) - cache for 1 week
/nhl-logos/*
  Cache-Control: public, max-age=604800
/headshots/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800

# Service workers - do not cache
/service-worker.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Data files (json) - cache for 10 minutes (matches poll interval consideration)
/data/*
  Cache-Control: public, max-age=600

# HTML files - revalidate to ensure updates are seen immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
